# Template only. Never replace your existing .env without reviewing it.
# scripts/dev.ps1 reads .env byte-for-byte without modifying it and points the process database to TMusicV2Dev.

# SQL Server (legacy key + V2 alias both supported)
ConnectionStrings__TMusic=Server=lpc:.\SQLEXPRESS;Database=TMusicV2Dev;Integrated Security=True;Encrypt=True;TrustServerCertificate=True
# ConnectionStrings__DefaultConnection=

# JWT Session Security (minimum 32 UTF-8 bytes)
Auth__SigningKey=
Auth__Issuer=TMusic
Auth__Audience=TMusic.Mobile
# Auth__Jwt__Issuer=TMusic
# Auth__Jwt__Audience=TMusic.Mobile
# Auth__Jwt__SigningKey=

# Email / SMTP (legacy Mail__* and V2 SMTP_* aliases both supported)
Mail__Host=127.0.0.1
Mail__Port=11025
Mail__UseTls=false
Mail__From=auth@tmusic.test
Mail__User=
Mail__Password=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=

# Google Sign-In
Auth__Google__Audiences=
TMUSIC_GOOGLE_SERVER_CLIENT_ID=
TMUSIC_GOOGLE_WEB_CLIENT_ID=
TMUSIC_GOOGLE_ANDROID_CLIENT_ID=
TMUSIC_GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple
TMUSIC_ENABLE_APPLE_SIGN_IN=false
Auth__Apple__Audiences=
Auth__Apple__TeamId=
Auth__Apple__KeyId=
Auth__Apple__PrivateKeyPath=

# YouTube Data API v3
YouTube__ApiKey=
YouTube__DailyQuotaBudget=8000

# Feature Gates
Features__EnableTikTokVideoImport=true
Features__EnableTikTokMetadata=true
Features__EnableMultiYouTubePlaylistMerge=false
Features__EnableCrossProviderMixedCollections=false
Features__EnableLicensedAudioDownload=false

# Local Docker SQL Server (docker-compose.yml only)
MSSQL_SA_PASSWORD=
ACCEPT_EULA=Y
